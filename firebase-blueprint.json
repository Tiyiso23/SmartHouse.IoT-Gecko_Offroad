{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "rental_operator", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Caravan": {
      "title": "Caravan",
      "description": "Smart Caravan device state, sensors and actuators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": "string" },
        "chassisNumber": { "type": "string" },
        "ownerUid": { "type": "string" },
        "firmwareVersion": { "type": "string" },
        "hardwareChip": { "type": "string" },
        "lastSeen": { "type": "string" },
        "signalRssi": { "type": "number" },
        "power": { "type": "object" },
        "environment": { "type": "object" },
        "tanks": { "type": "object" },
        "security": { "type": "object" },
        "actuators": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "chassisNumber", "ownerUid"]
    },
    "Alert": {
      "title": "Alert",
      "description": "System, security and power alert notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "caravanId": { "type": "string" },
        "timestamp": { "type": "string" },
        "severity": { "type": "string", "enum": ["critical", "warning", "info"] },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "acknowledged": { "type": "boolean" }
      },
      "required": ["id", "caravanId", "severity", "title", "message"]
    },
    "Automation": {
      "title": "Automation",
      "description": "Configurable autonomous edge rules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "enabled": { "type": "boolean" },
        "triggerType": { "type": "string" },
        "conditionSummary": { "type": "string" },
        "actionSummary": { "type": "string" },
        "executionCount": { "type": "number" }
      },
      "required": ["id", "name", "enabled", "triggerType"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user identity and roles"
    },
    "/caravans/{caravanId}": {
      "schema": { "$ref": "#/entities/Caravan" },
      "description": "Live state, telemetry and actuators for a caravan"
    },
    "/caravans/{caravanId}/automations/{automationId}": {
      "schema": { "$ref": "#/entities/Automation" },
      "description": "Edge automation rules for a caravan"
    },
    "/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/Alert" },
      "description": "System security and diagnostics alerts"
    }
  }
}
