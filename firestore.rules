rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'heavymanmakhubel001@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if isAdmin();
    }

    // Caravans Collection
    match /caravans/{caravanId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(caravanId);
      allow update: if isSignedIn() && isValidId(caravanId);
      allow delete: if isAdmin();

      // Automations Subcollection
      match /automations/{automationId} {
        allow read, write: if isSignedIn() && isValidId(automationId);
      }
    }

    // Alerts Collection
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(alertId);
      allow update: if isSignedIn() && isValidId(alertId);
      allow delete: if isAdmin();
    }
  }
}
